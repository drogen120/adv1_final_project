<!--
  Pick-and-place scene (not part of MuJoCo Menagerie).

  Like scene_box.xml, but the box is a 4 cm cube placed inside the arm's top-down grasp
  workspace (about 0.10-0.30 m from the base); at x = 0.5 m, as in scene_box.xml, it is out
  of reach. A cube rather than the 6 cm tall box because top-down tool poses only reach
  ~0.06-0.09 m up (wrist_flex limit), too low to pass the open jaws over a 6 cm box.
  sim_node randomizes the box pose on reset (see its box_* parameters). The red square
  marks the place target; it is visual only.
-->
<mujoco model="scene_pick_place">
  <include file="so101.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane"/>
    <body name="box" pos="0.18 0.07 0.02">
      <freejoint/>
      <geom type="box" name="box" size="0.02 0.02 0.02" condim="3" friction="1 .03 .003" rgba="0 1 0 1" contype="2"
        conaffinity="1" solref="0.01 1"/>
    </body>
    <site name="target" type="box" pos="0.22 -0.12 0.0005" size="0.03 0.03 0.0005" rgba="1 0 0 0.6"/>
    <camera name="overview" pos="0.55 0 0.45" xyaxes="0 1 0 -0.6 0 0.8"/>
  </worldbody>
</mujoco>
